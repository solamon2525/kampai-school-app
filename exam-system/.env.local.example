# Example environment variables for production (Upstash Redis)
# Copy this file to .env.local and fill in values from your Upstash dashboard

UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# URL ของหน้าหลัก Super App (ใช้สำหรับปุ่มกลับหน้าหลัก)
NEXT_PUBLIC_HOME_URL=https://your-school-app-url.com
